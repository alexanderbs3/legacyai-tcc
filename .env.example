# Exemplo local. Substitua os placeholders antes de iniciar os serviços.
# O Compose e o backend precisam da MESMA senha para o PostgreSQL local.
POSTGRES_PASSWORD=replace_with_local_dev_password
SPRING_DATASOURCE_PASSWORD=replace_with_local_dev_password

# Texto UTF-8 com pelo menos 32 bytes; não é uma string Base64.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes

# Omitir/deixar vazia a chave de um provider o torna indisponível.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Opcionais (padrões em backend/src/main/resources/application.properties):
# SERVER_PORT=8080
# JWT_EXPIRATION_MS=3600000
# Para CORS e armazenamento, configure as propriedades Spring
# legacyai.cors.allowed-origins e upload.temp-dir no ambiente de implantação.
# .env não é carregado automaticamente pelo backend: exporte no shell
# ou configure as variáveis na execução pelo IntelliJ.